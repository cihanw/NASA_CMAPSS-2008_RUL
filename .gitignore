# Ignore everything by default.
*

# Allow Git to walk directories so nested allow-rules can match.
!*/

# Keep this policy file.
!.gitignore

# Keep the project README.
!README.md

# Keep dataset files used by the project.
!data/
!data/raw/
!data/raw/*.txt
!data/processed/
!data/processed/*.csv

# Keep project preprocess and training code only.
!Preprocess/
!Preprocess/*.py
!scripts/
!scripts/fd002_sensor_selection_and_clustering.py
!notebooks/
!notebooks/*.ipynb
!model_script/
!model_script/*.ipynb

# Keep runnable project definitions.
!requirements*.txt
!pyproject.toml
!setup.py
!setup.cfg
!tox.ini
!pytest.ini
!environment.yml
!environment.yaml

# Presentation, report, source-template, and generated model outputs stay local.
reports/
artifacts/
kaynaklar/
models/

# Keep generated and local-only files out even when nested under allowed paths.
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments and machine/editor noise.
.venv/
venv/
env/
ENV/
.env
.env.*
.DS_Store
.idea/
.vscode/
